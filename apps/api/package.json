{
  "name": "@whalepartner/api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "smoke": "node src/cli.ts --smoke",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "login": "node src/cli.ts login",
    "status": "node src/cli.ts status",
    "logout": "node src/cli.ts logout",
    "summarize": "node src/cli.ts summarize",
    "web": "node src/dev-server.ts",
    "benchmark:videos": "node scripts/video-benchmark.mjs",
    "memory:profile": "node scripts/memory-recall-profile.mjs",
    "serve": "node --env-file-if-exists=.env src/server.ts",
    "llm:ping": "node --env-file-if-exists=.env src/llm-ping.ts",
    "persona:eval": "node scripts/persona-eval.mjs",
    "memory:smoke": "node --env-file-if-exists=.env scripts/memory-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "cron": "4.4.0",
    "mem0ai": "^3.3.1",
    "playwright-core": "^1.65.0"
  }
}
