# 复制为 .env 后填写；真实 .env 不会提交。密钥只由服务端读取，不进客户端。
# 主模型：DeepSeek（OpenAI 兼容接口）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 备用模型：任意 OpenAI 兼容接口，三项都填才会启用
BACKUP_LLM_BASE_URL=
BACKUP_LLM_API_KEY=
BACKUP_LLM_MODEL=

# 本机 Codex 兜底（仅本地开发）；设为 0 关闭
# CODEX_FALLBACK=1

# API_HOST=127.0.0.1
# API_PORT=8787
# LLM_TIMEOUT_MS=30000
