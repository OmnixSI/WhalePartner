{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "鲸汐",
  "version": "0.3.1",
  "identifier": "com.omnixsi.whalepartner",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --dir ../api run build:sidecar -- --dev && pnpm dev",
    "beforeBuildCommand": "pnpm --dir ../api run build:sidecar && pnpm run prepare-live2d && pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "鲸汐 · WhalePartner",
        "visible": false,
        "backgroundColor": "#F6EFE2",
        "width": 1180,
        "height": 780,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://127.0.0.1:* http://localhost:* http: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:* http: https: ws: wss: ipc: http://ipc.localhost; media-src 'self' blob: http://127.0.0.1:* http://localhost:* http: https:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/whale-node"],
    "resources": {
      "sidecar/api": "api",
      "sidecar/bin": "bin"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
